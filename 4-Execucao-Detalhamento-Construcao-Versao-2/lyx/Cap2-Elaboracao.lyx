\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
E=E^{\circ}-\frac{0{,}0591}{n}\log\left(\frac{{a_{R}}^{r}\cdot{a_{Q}}^{q}}{{a_{L}}^{l}\cdot{a_{M}}^{m}}\right)
\end{equation}

\end_inset


\end_layout

